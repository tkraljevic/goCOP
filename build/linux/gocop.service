# goCOP čvor kao usluga sustava (systemd).
#
# Postavlja je build/linux/instaliraj.sh, a upute su u docs/linux.md.
# Program radi kao zaseban korisnik gocop. Baza, ključ čvora i gocop.toml
# su u /var/lib/gocop; ostatak sustava program može samo čitati.
#
# Izmjene ne upisivati ovdje (skripta je pri nadogradnji vraća), nego u
# dopunu: sudo systemctl edit gocop

[Unit]
Description=goCOP čvor (obrana od poplava)
Documentation=https://github.com/tkraljevic/goCOP/blob/master/docs/linux.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gocop
Group=gocop

# systemd stvara /var/lib/gocop i daje je korisniku gocop. Relativne
# putanje iz postavki (podaci, pakete) padaju u nju, a gocop.toml se traži
# uz bazu.
StateDirectory=gocop
StateDirectoryMode=0750
WorkingDirectory=/var/lib/gocop

# Bez -upravitelj: pod systemd-om je standardni ulaz prazan, a s tom
# zastavicom čvor se gasi čim mu se zatvori ulaz.
ExecStart=/usr/local/bin/gocop -db /var/lib/gocop/gocop.db

# Prikaz je uvijek u zoni Zagreba, ali neka se vremena (unos epizode,
# vrijeme snimanja fotografije) čitaju u mjesnoj zoni računala, a
# poslužitelji su često u UTC-u. Isto postavlja i spremnik (Dockerfile).
Environment=TZ=Europe/Zagreb

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Web je zadano na portu 80. Usluga za to dobiva samo ovo jedno pravo;
# bez njega program sam prelazi na 8080.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Ograničenja
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_NETLINK treba za popis mrežnih sučelja (pronalaženje čvorova, UDP 4712)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
